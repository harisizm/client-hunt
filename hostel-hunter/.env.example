# Copy this file to ".env" and change anything you like, then restart the app.
# The app also runs fine without a .env — these are the built-in defaults.

# Web address becomes http://localhost:PORT
PORT=7777
# Open the browser automatically at start (true/false)
AUTO_OPEN_BROWSER=true

# Pause between two places, in seconds (random between min and max)
PLACE_DELAY_MIN_SEC=0.35
PLACE_DELAY_MAX_SEC=0.9
# Rest between batches of places, in seconds
REST_MIN_SEC=4
REST_MAX_SEC=6
# After a Google check appears, retry by itself after this many minutes
CAPTCHA_RETRY_MINUTES=3

# Pause between scroll steps, in seconds
SCROLL_STEP_MIN_SEC=0.45
SCROLL_STEP_MAX_SEC=0.7
# Stop scrolling if the list has not grown for this many seconds
FEED_STALL_TIMEOUT_SEC=15

# How far the extra deep-search map tiles shift, in degrees (0.012 = ~1.3 km)
DEEP_TILE_OFFSET=0.012
# Map zoom for the deep-search tiles (higher = smaller area per tile)
DEEP_TILE_ZOOM=15
# Most extra searches to try before stopping
DEEP_MAX_PASSES=30
# Stop early after this many searches in a row find nothing new
DEEP_STOP_AFTER_EMPTY=5
# How many rings of map tiles around the area (each ring = 8 searches)
DEEP_RINGS=3

# true = invisible browser (recommended), false = watch it work
HEADLESS=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
